{
  "name": "mc-build",
  "version": "4.1.3",
  "description": "A language for creating minecraft datapacks",
  "module": "dist/libmcb.js",
  "browser": "dist/libmcb.browser.js",
  "bin": {
    "mcb3": "./dist/mcb.js",
    "mc-build": "./dist/mcb.js",
    "mcb": "./dist/mcb.js"
  },
  "exports": {
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    },
    "./perf": {
      "import": "./dist/libmcb.perf.js",
      "types": "./dist/libmcb.d.ts"
    },
    ".": {
      "import": "./dist/libmcb.js",
      "types": "./dist/libmcb.d.ts"
    }
  },
  "types": "dist/libmcb.d.ts",
  "repository": "git@github.com:mc-build/mcb.git",
  "author": "Ian Senne <ian@iansenne.com>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run typecheck && tsx scripts/build.ts",
    "test": "tsx src/testbed/TestMain.ts",
    "vitest": "vitest",
    "test:write": "tsx src/testbed/TestMain.ts --write",
    "build:perf": "tsx scripts/build.ts && tsx scripts/transform-perf.ts dist/mcb.js dist/mcb.perf.js && tsx scripts/transform-perf.ts dist/libmcb.js dist/libmcb.perf.js",
    "build:perf:all": "tsx scripts/build.ts && tsx scripts/transform-perf.ts dist/testbed.js dist/testbed.perf.js && tsx scripts/transform-perf.ts dist/mcb.js dist/mcb.perf.js && tsx scripts/transform-perf.ts dist/libmcb.js dist/libmcb.perf.js && node dist/testbed.perf.js",
    "dev": "nodemon --config nodemon.json",
    "dist": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "dts2hx": "^0.20.0",
    "esbuild": "^0.25.12",
    "figures": "^6.0.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.6.2",
    "tsx": "^4.7.2",
    "typescript": "^5.2.2",
    "vitest": "^4.0.4",
    "magic-string": "^0.30.21",
    "oxc-parser": "^0.132.0"
  }
}
