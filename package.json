{
  "name": "mc-build",
  "version": "3.6.7",
  "description": "A language for creating minecraft datapacks",
  "module": "dist/libmcb.js",
  "main": "dist/main.js",
  "bin": {
    "mcb3": "./dist/main.js",
    "mc-build": "./dist/main.js",
    "mcb": "./dist/main.js"
  },
  "types": "dist/libmcb.d.ts",
  "repository": "git@github.com:mc-build/mcb.git",
  "author": "Ian Senne <ian@iansenne.com>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "./build-ts.sh",
    "build:ts-only": "tsc",
    "build:old-haxe": "yarn build:io-worker && ./build.sh",
    "build:io-worker": "tsx ./scripts/compileIoThread.ts",
    "build:haxe": "haxe build.hxml",
    "test": "echo 'Tests not yet migrated to TypeScript'",
    "dev": "tsc --watch",
    "dist": "yarn build",
    "setup-deps": "echo 'Haxe dependencies no longer needed'",
    "setup": "echo 'Haxe setup no longer needed'"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "commander": "^14.0.1",
    "figures": "^6.0.1",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.6",
    "@types/node": "^20.8.4",
    "dts2hx": "^0.20.0",
    "esbuild": "^0.19.4",
    "nodemon": "^3.0.1",
    "tsx": "^4.7.2",
    "typescript": "^5.2.2"
  }
}
