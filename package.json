{
  "name": "mc-build",
  "version": "4.0.1",
  "description": "A language for creating minecraft datapacks",
  "module": "dist/libmcb.js",
  "browser": "dist/libmcb.browser.js",
  "bin": {
    "mcb3": "./dist/mcb.js",
    "mc-build": "./dist/mcb.js",
    "mcb": "./dist/mcb.js"
  },
  "types": "dist/libmcb.d.ts",
  "repository": "git@github.com:mc-build/mcb.git",
  "author": "Ian Senne <ian@iansenne.com>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run typecheck && tsx scripts/build.ts",
    "test": "tsx src/testbed/TestMain.ts",
    "vitest": "vitest",
    "test:write": "tsx src/testbed/TestMain.ts --write",
    "dev": "nodemon --config nodemon.json",
    "dist": "npm run build"
  },
  "devDependencies": {
    "@prettier/sync": "^0.6.1",
    "@types/node": "^20.8.4",
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "dts2hx": "^0.20.0",
    "esbuild": "^0.19.4",
    "figures": "^6.0.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.6.2",
    "tsx": "^4.7.2",
    "typescript": "^5.2.2",
    "vitest": "^4.0.4"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
