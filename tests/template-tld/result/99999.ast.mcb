### lib.mcbt

### main.mcb
function kills_inc{
	scoreboard players add #kills counters 1
}
damage_type kills { "exhaustion": 0, "message_id": "generic", "scaling": "never" }
tag functions kills_tag {
	./kills_inc
}
dir kills_dir{
	function reset{
		scoreboard players set #kills counters 0
	}
}
dir nested{
	function deaths_inc{
		scoreboard players add #deaths counters 1
	}
	damage_type deaths { "exhaustion": 0, "message_id": "generic", "scaling": "never" }
	tag functions deaths_tag {
		./deaths_inc
	}
	dir deaths_dir{
		function reset{
			scoreboard players set #deaths counters 0
		}
	}
}
function loop_1_inc{
	scoreboard players add #loop_1 counters 1
}
damage_type loop_1 { "exhaustion": 0, "message_id": "generic", "scaling": "never" }
tag functions loop_1_tag {
	./loop_1_inc
}
dir loop_1_dir{
	function reset{
		scoreboard players set #loop_1 counters 0
	}
}
function loop_2_inc{
	scoreboard players add #loop_2 counters 1
}
damage_type loop_2 { "exhaustion": 0, "message_id": "generic", "scaling": "never" }
tag functions loop_2_tag {
	./loop_2_inc
}
dir loop_2_dir{
	function reset{
		scoreboard players set #loop_2 counters 0
	}
}
function greet{
	function main:zzz/0
}
function use_counter{
	function ./kills_inc
}
