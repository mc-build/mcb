### lib.mcbt

### main.mcb
function alpha_0{
	say alpha 0
}
function alpha_1{
	say alpha 1
}
damage_type alpha {
	"scaling": "never"
}
function alpha_inner{
	say from inner
}
dir nested{
	function beta_0{
		say beta 0
	}
	damage_type beta {
		"scaling": "never"
	}
	function beta_inner{
		say from inner
	}
}
