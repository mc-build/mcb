        a:b
    }
    tag functions test3 {
        *foobar
        *foobar2 replace
        a:b
    }
    tag blocks test{
        *foobar
        minecraft:stone replace
        minecraft:dirt
        #foo:bar
        <%"#foo:bar/baz"%>
    }
    tag worldgen/biome worldgen_biome_tag {
        minecraft:plains
    }
