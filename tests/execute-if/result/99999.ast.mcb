### main.mcb
function test{
	execute if score a b = 2 run {
		say 1
	} else execute if score a b = 3 run {
		say 2
	} else run {
		say 3
	}
	$execute if score a b = 2 run {
		say 1
	} else $execute if score a b = 3 run {
		say 2
	} else $run {
		say 3
	}
	execute unless {
		return fail
	} run say tail


	execute if {
		return 1
	} run {
		say block tail
	}
	execute if {
		return 1
	} if {
		return 1
	} as @a run say chained


}
