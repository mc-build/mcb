		}
		IF (0) {
			'conditionalValue',
		} ELSE IF (1) {
			'anotherConditionalValue',
		} ELSE {
			'alternateValue',
		}
		<%JSON.stringify({'foo': 'bar'})%>
		<%%
			emit(JSON.stringify({'foo': 'bar'}));
		%%>
	]
]

