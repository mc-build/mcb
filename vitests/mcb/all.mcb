# Contains all `.mcb` file syntax

# Comments
	# Tab-indented Comment
		# with extra indentation
	# Space-indented Comment
		# with extra indentation

###
Multi-line Comments

function basic_definition {
	say basic definition
}
###

# Function Definitions
# "Recommended" whitespace
function basic_definition {
	say basic definition
}
function add_to_tag minecraft:tick {
	say add to tag
}
function add_to_tag_no_namespace tick {
	say add to tag no namespace
}
# Heavy whitespace
function

basic_definition_heavy_whitespace

{

	say basic definition

}

function

add_to_tag_heavy_whitespace

minecraft:tick

{

	say add to tag

}

function

add_to_tag_no_namespace_heavy_whitespace

tick

{

	say add to tag no namespace

}

# Min whitespace
function basic_definition_min_whitespace{
	say basic definition
}
function add_to_tag_min_whitespace minecraft:tick{
	say add to tag
}
function add_to_tag_no_namespace_min_whitespace tick{
	say add to tag no namespace
}

# Line continuations
function line_continuations {
	say This is a long message that \
		continues on the next line \
		and should be treated as a single line.
}

function bracket_multiline {
	tellraw @a [
		'',
		[
			{ text: '[', color: gray }, { text:'A*',color: green}, ']'
		],
		{ text: ' Queued Path', color: white },
		{ text: ' QueueLength=', color: yellow }, { score: { name: '#queue_length', objective: astar.v }},
		{ text: ' ID=', color: yellow }, { score: { name: '#astar.last_path_id', objective: astar.v }},
		{ text: ' From=', color: light_purple },
		'[',
		{ storage: 'astar:data', nbt:'path_queue[-1].from.x', color: red }, ' ',
		{ storage: 'astar:data', nbt:'path_queue[-1].from.y', color: green }, ' ',
		{ storage: 'astar:data', nbt:'path_queue[-1].from.z', color: blue },
		']',
		{ text: ' To=', color: light_purple },
		'[',
		{ storage: 'astar:data', nbt:'path_queue[-1].to.x', color: red }, ' ',
		{ storage: 'astar:data', nbt:'path_queue[-1].to.y', color: green }, ' ',
		{ storage: 'astar:data', nbt:'path_queue[-1].to.z', color: blue },
		']'
	]
}

# Blocks
function blocks {
	# Max whitespace
	{
		say anonymous block
	}
	block {
		say anonymous block with keyword
	}
	block foo {
		say named block
	}
	{ { boo: 1, bar: 2, baz: 3 }
		say anonymous block with arguments
	}
	block { { boo: 1, bar: 2, baz: 3 }
		say anonymous block with keyword and arguments
	}
	block foo { { boo: 1, bar: 2, baz: 3 }
		say named block with arguments
	}
	{ with storage mcb:data test.path[0].name
		say anonymous block with 'with' clause
	}
	block { with storage mcb:data test.path[0].name
		say anonymous block with keyword and 'with' clause
	}
	block foo { with storage mcb:data test.path[0].name
		say named block with 'with' clause
	}
	# Min Whitespace
	{{boo:1,bar:2,baz:3}
		say anonymous block with arguments
	}
	block {{boo:1,bar:2,baz:3}
		say anonymous block with keyword and arguments
	}
	block foo {{boo:1,bar:2,baz:3}
		say named block with arguments
	}
	{with storage mcb:data test.path[0].name
		say anonymous block with 'with' clause
	}
	block {with storage mcb:data test.path[0].name
		say anonymous block with keyword and 'with' clause
	}
	block foo {with storage mcb:data test.path[0].name
		say named block with 'with' clause
	}
}

# Clocks
clock foo 1t {
	say tick clock
}
clock foo 1s {
	say second clock
}
clock foo 1d {
	say day clock
}
clock foo 1t{
	say tick clock
}

# Compile IF / ELSE
# "Recommended" Whitespace
IF (true) {
	function true {
		say true
	}
} ELSE {
	function false {
		say false
	}
}
# Heavy Whitespace
IF

(
	true
)

{

	function true {
		say true
	}

}

ELSE

{

	function false {
		say false
	}

}

# Min Whitespace
IF(true){
	function true {
		say true
	}
}ELSE{
	function false {
		say false
	}
}
function test_compile_if_else {
	# "Recommended" Whitespace
	IF (true) {
		say true
	} ELSE {
		say false
	}
	# Heavy Whitespace
	IF

	(
		true
	)

	{

		say true

	}

	ELSE

	{

		say false

	}

	# Min Whitespace
	IF(true){
		say true
	}ELSE{
		say false
	}
}
IF (0) {
	function zero {
		say zero
	}
} ELSE IF (1) {
	function one {
		say one
	}
} ELSE {
	function not_zero_nor_one {
		say not zero nor one
	}
}

IF

(
	0
)

{

	function zero {
		say zero
	}

}

ELSE IF

(
	1
)

{

	function one {
		say one
	}

}

ELSE

{

	function not_zero_nor_one {
		say not zero nor one
	}

}

IF(0){
	function zero {
		say zero
	}
}ELSE IF(1){
	function one {
		say one
	}
}ELSE{
	function not_zero_nor_one {
		say not zero nor one
	}
}
function test_compile_if_else {
	IF (0) {
		say zero
	} ELSE IF (1) {
		say one
	} ELSE {
		say not zero nor one
	}

	IF

	(
		0
	)

	{

		say zero

	}

	ELSE IF

	(
		1
	)

	{
		say one
	}

	ELSE

	{
		say not zero nor one
	}

	IF(0){
		say zero
	}ELSE IF(1){
		say one
	}ELSE{
		say not zero nor one
	}
}

# Compile REPEAT
REPEAT (3) as i {
	function repeat<%i%> {
		say repeat <%i%>
	}
}
REPEAT

(

	3

)

as i

{

	function repeat<%i%> {
		say repeat <%i%>
	}

}
REPEAT(3)as i{
	function repeat<%i%> {
		say repeat <%i%>
	}
}
function repeat {
	REPEAT (3) as i {
		say repeat <%i%>
	}
	REPEAT

	(
		3
	)

	as i

	{

		say repeat <%i%>

	}
	REPEAT(3)as i{
		say repeat <%i%>
	}
}

# Directories
dir mcb {
	function test {
		say in mcb dir
	}
	dir subdir {
		function test {
			say in subdir
		}
	}
}
dir

mcb

{

	function test {
		say in mcb dir
	}

	dir

	subdir

	{

		function test {
			say in subdir
		}

	}

}
dir mcb_nospace{
	function test {
		say in mcb dir
	}
	dir subdir{
		function test {
			say in subdir
		}
	}
}

# Execute run
function execute_run {
	execute if score @s #condition v matches 1.. run say hi
	execute \
		if score @s #condition v matches 1.. run \
		say hi

	execute if score @s #success v matches 1.. run {
		say execute run block
	}
	execute if score @s #success v matches 1.. run { {a: 1, b: 2, c: 3}
		say success
	}
	execute if score @s #success v matches 1.. run { with storage mcb:data test.path[0].name
		say success
	}

	execute \
		if score @s #success v matches 1.. \
	run {
		say execute run block
	}
	execute \
		if score @s #success v matches 1.. \
	run { {a: 1, b: 2, c: 3}
		say success
	}
	execute \
		if score @s #success v matches 1.. \
	run { with storage mcb:data test.path[0].name
		say success
	}

	execute if score @s #success v matches 1.. run

	{

		say execute run block

	}

	execute if score @s #success v matches 1.. run

	{ {a: 1, b: 2, c: 3}

		say success

	}

	execute if score @s #success v matches 1.. run

	{ with storage mcb:data test.path[0].name

		say success

	}

	execute if score @s #success v matches 1.. run{
		say execute run block
	}
	execute if score @s #success v matches 1.. run{{a:1,b:2,c:3}
		say success
	}
	execute if score @s #success v matches 1.. run{with storage mcb:data test.path[0].name
		say success
	}
}

# Execute if / else
function execute_if_else {
	execute if score @s #condition v matches 1.. run {
		say execute if
	} else run {
		say execute else
	}
	execute if score @s #condition v matches 1.. run {
		say execute if
	} else execute if score @s #other_condition v matches 1.. run {
		say execute if-else
	} else run {
		say execute else
	}

	execute if score @s #condition v matches 1.. run{
		say execute if
	}else run{
		say execute else
	}
	execute if score @s #condition v matches 1.. run{
		say execute if
	}else execute if score @s #other_condition v matches 1.. run{
		say execute if-else
	}else run{
		say execute else
	}
}

# Execute if / unless function
function execute_if_unless_function {
	execute if function {
		return 1
	} run {
		say success
	}
	execute unless function {
		return 0
	} run {
		say success
	}

	execute if function{
		return 1
	}run{
		say success
	}
	execute unless function{
		return 0
	}run{
		say success
	}
}

# Function Calls
function function_calls {
	block child {
		function ^1
		function ^0
		function *foo/bar
		function ../parent/path
		function ./relative/path
	}
	function ^0
	function *foo/bar
	function ./relative/path
}

# Imports
import ./foo/my_script.js
import ./bar/my_template.mcbt

# JavaScript Blocks, and Contexts
# Petition to rename these to Script Blocks
function inline_js_blocks {
	say <%   10 ** 2   %>
	say <%   0x00ACED   %>
	say <%   config.dev   %>

	say <%10 ** 2%>
	say <%0x00ACED%>
	say <%config.dev%>
}
function multiline_js_blocks {
	<%%
		emit('say hi')
		emit.mcb('function inside_multiline_js_block {\n\tsay hello from the other side\n}')
		emit.block(commands:['say hi', 'say hi1', 'say hi2'])
		console.log(config)
		console.log(context)
		embed(/* TODO - Define embeddedBlock */embeddedBlock)
		require('./some/other/script.js')
	%%>
}

# Tick and Load Blocks
function tick_and_load_blocks {
	tick {
		say tick block
	}
	load {
		say load block
	}
	tick{
		say tick block
	}
	load{
		say load block
	}

	tick

	{

		say tick block

	}

	load

	{

		say load block

	}
}

# Schedule Blocks
function schedule_blocks {
	# Recommended Whitespace
	schedule 1 {
		say 1 tick no suffix
	}
	schedule 1t {
		say 1 tick
	}
	schedule 1s {
		say 1 second
	}
	schedule 1d {
		say 1 day
	}
	schedule 1d replace {
		say 1 day explicit replace
	}
	schedule 1d append {
		say 1 day append
	}
	schedule 1t block name {
		say with name
	}
	schedule 1t replace block name {
		say with name and explicit replace
	}
	schedule 1t append block name {
		say with name and append
	}

	# Heavy Whitespace
	schedule 1

	{

		say 1 tick no suffix

	}

	schedule 1t

	{

		say 1 tick

	}

	schedule 1s

	{

		say 1 second

	}

	schedule 1d

	{

		say 1 day

	}

	schedule 1d replace

	{

		say 1 day explicit replace

	}

	schedule 1d append

	{

		say 1 day append

	}

	schedule 1t block name

	{

		say with name

	}

	schedule 1t replace block name

	{

		say with name and explicit replace

	}

	schedule 1t append block name

	{

		say with name and append

	}

	# Min Whitespace
	schedule 1{
		say 1 tick no suffix
	}
	schedule 1t{
		say 1 tick
	}
	schedule 1s{
		say 1 second
	}
	schedule 1d{
		say 1 day
	}
	schedule 1d replace{
		say 1 day explicit replace
	}
	schedule 1d append{
		say 1 day append
	}
	schedule 1t block name{
		say with name
	}
	schedule 1t replace block name{
		say with name and explicit replace
	}
	schedule 1t append block name{
		say with name and append
	}
}

json advancement foo:bar {
	// Comments
	unquoted: 'and you can quote me on that',
	singleQuotes: 'I can use "double quotes" here',
	lineBreaks: "Look, Mom! \n\
	No \\n's!",
	hexadecimal: 0xdecaf,
	leadingDecimalPoint: .8675309, andTrailing: 8675309.,
	positiveSign: +1,
	trailingComma: 'in objects', andIn: ['arrays',],
	"backwardsCompatible": "with JSON",
	generatedObject: {
		REPEAT (10) as i {
			'<%i%>': <%i%>,
		}
		IF (0) {
			a: 'conditionalValue',
		} ELSE IF (1) {
			b: 'anotherConditionalValue',
		} ELSE {
			c: 'alternateValue',
		}
		<%JSON.stringify({'foo': 'bar'})%>
		<%%
			emit(JSON.stringify({'foo': 'bar'}));
		%%>
	},
	generatedArray: [
		REPEAT (10) as i {
			<%i%>,
		}
		IF (0) {
			'conditionalValue',
		} ELSE IF (1) {
			'anotherConditionalValue',
		} ELSE {
			'alternateValue',
		}
		<%JSON.stringify({'foo': 'bar'})%>
		<%%
			emit(JSON.stringify({'foo': 'bar'}));
		%%>
	]
}

