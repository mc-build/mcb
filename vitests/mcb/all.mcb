# Tags
tag function foo {
	foo:bar
	#baz:qux
}
tag functions namespace:foo {
	foo:bar
	#baz:qux
}
tag block foo {
	foo:bar
	#baz:qux
}
tag blocks namespace:foo {
	foo:bar
	#baz:qux
}
tag function foo{
	foo:bar
	#baz:qux
}
tag functions namespace:foo{
	foo:bar
	#baz:qux
}
tag block foo{
	foo:bar
	#baz:qux
}
tag blocks namespace:foo{
	foo:bar
	#baz:qux
}

# Templates
function templates {
	template my_template has 3 arguments
	my_template has 3 arguments
}

# Tick and Load Blocks
function tick_and_load_blocks {
	tick {
		say tick block
	}
	load {
		say load block
	}
	tick{
		say tick block
	}
	load{
		say load block
	}
}

# Schedule Blocks
function schedule_blocks {
	schedule foo 1 {
		say 1 tick no suffix
	}
	schedule foo 1t {
		say 1 tick
	}
	schedule foo 1s {
		say 1 second
	}
	schedule foo 1d {
		say 1 day
	}
	schedule foo 1d replace {
		say 1 day replace
	}
	schedule foo 1d append {
		say 1 day append
	}
	schedule foo 1{
		say 1 tick no suffix
	}
	schedule foo 1t{
		say 1 tick
	}
	schedule foo 1s{
		say 1 second
	}
	schedule foo 1d{
		say 1 day
	}
	schedule foo 1d replace{
		say 1 day replace
	}
	schedule foo 1d append{
		say 1 day append
	}
}

# Line continuations
function line_continuations {
	say This is a long message that \
		continues on the next line \
		and should be treated as a single line.
}
